					"raw": "{{api_base}}/api/member/withdrawals/{{withdrawal_id}}/receipt",
					"host": ["{{api_base}}"],
					"path": ["api", "member", "withdrawals", "{{withdrawal_id}}", "receipt"]
				},
				"description": "Download withdrawal receipt PDF. Requires authentication and valid withdrawal ID."
			},
			"response": []
		},
