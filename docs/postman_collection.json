{
	"info": {
		"_postman_id": "earniq-api-smoke-tests",
		"name": "Earniq API Smoke Tests",
		"description": "Complete smoke test collection for Earniq API endpoints. Run in sequence after setting environment variables.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Auth - Request OTP",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Response has ok or success field\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('ok').or.have.property('success');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"phone\": \"{{phone}}\"\n}"
				},
				"url": {
					"raw": "{{api_base}}/api/auth/otp/request",
					"host": ["{{api_base}}"],
					"path": ["api", "auth", "otp", "request"]
				},
				"description": "Request OTP for phone number. Expect 200 with ok: true or success: true."
			},
			"response": []
		},
		{
			"name": "2. Auth - Verify OTP",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Response has success and user object\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('success', true);",
							"    pm.expect(jsonData).to.have.property('user');",
							"    pm.expect(jsonData.user).to.have.property('id');",
							"    pm.expect(jsonData.user).to.have.property('phone');",
							"    pm.expect(jsonData.user).to.have.property('role');",
							"});",
							"pm.test(\"User object has all expected fields\", function () {",
							"    const user = pm.response.json().user;",
							"    pm.expect(user).to.have.property('username');",
							"    pm.expect(user).to.have.property('email');",
							"    pm.expect(user).to.have.property('referral_code');",
							"    pm.expect(user).to.have.property('upi_id');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"phone\": \"{{phone}}\",\n  \"otp\": \"{{otp}}\",\n  \"referralCode\": null\n}"
				},
				"url": {
					"raw": "{{api_base}}/api/auth/otp/verify",
					"host": ["{{api_base}}"],
					"path": ["api", "auth", "otp", "verify"]
				},
				"description": "Verify OTP and receive auth cookies. Sets earniq_access_token and earniq_refresh_token cookies."
			},
			"response": []
		},
		{
			"name": "3. Auth - Get Session",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Response has full user object\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('success', true);",
							"    pm.expect(jsonData).to.have.property('user');",
							"    const user = jsonData.user;",
							"    pm.expect(user).to.have.property('id');",
							"    pm.expect(user).to.have.property('phone');",
							"    pm.expect(user).to.have.property('username');",
							"    pm.expect(user).to.have.property('email');",
							"    pm.expect(user).to.have.property('referral_code');",
							"    pm.expect(user).to.have.property('upi_id');",
							"    pm.expect(user).to.have.property('role');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{api_base}}/api/auth/session",
					"host": ["{{api_base}}"],
					"path": ["api", "auth", "session"]
				},
				"description": "Get current session with full user object. Requires authentication cookies."
			},
			"response": []
		},
		{
			"name": "4. Tasks - List Tasks",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Response has tasks array\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('tasks');",
							"    pm.expect(jsonData.tasks).to.be.an('array');",
							"});",
							"pm.test(\"Task objects have required fields\", function () {",
							"    const tasks = pm.response.json().tasks;",
							"    if (tasks.length > 0) {",
							"        const task = tasks[0];",
							"        pm.expect(task).to.have.property('id');",
							"        pm.expect(task).to.have.property('title');",
							"        pm.expect(task).to.have.property('slug');",
							"        pm.expect(task).to.have.property('reward_amount');",
							"        pm.expect(task).to.have.property('reward_coins');",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{api_base}}/api/tasks?category_id={{category_id}}&difficulty=easy&is_active=true&limit=10",
					"host": ["{{api_base}}"],
					"path": ["api", "tasks"],
					"query": [
						{
							"key": "category_id",
							"value": "{{category_id}}",
							"description": "Optional category filter"
						},
						{
							"key": "difficulty",
							"value": "easy",
							"description": "easy, medium, hard"
						},
						{
							"key": "is_active",
							"value": "true",
							"description": "Filter active tasks"
						},
						{
							"key": "limit",
							"value": "10",
							"description": "Limit results"
						}
					]
				},
				"description": "List tasks with filters: category_id, difficulty, is_active. Uses backend-supported filters."
			},
			"response": []
		},
		{
			"name": "5. Tasks - Get Task Detail",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Response has task object\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('task');",
							"    const task = jsonData.task;",
							"    pm.expect(task).to.have.property('id');",
							"    pm.expect(task).to.have.property('title');",
							"    pm.expect(task).to.have.property('description');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{api_base}}/api/tasks/{{task_id}}",
					"host": ["{{api_base}}"],
					"path": ["api", "tasks", "{{task_id}}"]
				},
				"description": "Get single task detail by ID. Includes user_submission_count, can_submit, is_expired."
			},
			"response": []
		},
		{
			"name": "6. Tasks - Submit Task (Multipart)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Response indicates success\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('success', true);",
							"    pm.expect(jsonData).to.have.property('submission');",
							"    pm.expect(jsonData.submission).to.have.property('id');",
							"    pm.expect(jsonData.submission).to.have.property('status');",
							"});",
							"pm.test(\"Save submission ID for later\", function () {",
							"    const submission = pm.response.json().submission;",
							"    if (submission && submission.id) {",
							"        pm.environment.set('submission_id', submission.id);",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "task_id",
							"value": "{{task_id}}",
							"type": "text"
						},
						{
							"key": "proof",
							"type": "file",
							"src": "/path/to/proof.jpg",
							"description": "Upload proof file (image/video)"
						},
						{
							"key": "notes",
							"value": "Test submission via Postman",
							"type": "text",
							"description": "Optional notes"
						}
					]
				},
				"url": {
					"raw": "{{api_base}}/api/member/tasks/submit",
					"host": ["{{api_base}}"],
					"path": ["api", "member", "tasks", "submit"]
				},
				"description": "Submit task with file upload. Uses multipart/form-data. Requires authentication."
			},
			"response": []
		},
		{
			"name": "7. Tasks - Get User Submissions",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Response has data array\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('data');",
							"    pm.expect(jsonData.data).to.be.an('array');",
							"});",
							"pm.test(\"Submissions have proof_url\", function () {",
							"    const submissions = pm.response.json().data;",
							"    if (submissions.length > 0) {",
							"        const submission = submissions[0];",
							"        pm.expect(submission).to.have.property('proof_url');",
							"        pm.expect(submission).to.have.property('status');",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{api_base}}/api/member/tasks/submissions?page=1&perPage=10",
					"host": ["{{api_base}}"],
					"path": ["api", "member", "tasks", "submissions"],
					"query": [
						{
							"key": "page",
							"value": "1"
						},
						{
							"key": "perPage",
							"value": "10"
						},
						{
							"key": "status",
							"value": "SUBMITTED",
							"description": "Optional: SUBMITTED, REVIEWING, APPROVED, REJECTED",
							"disabled": true
						}
					]
				},
				"description": "Get user's task submissions with pagination. Requires authentication."
			},
			"response": []
		},
		{
			"name": "8. Withdrawals - Request Withdrawal",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Response has withdrawal object\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('success', true);",
							"    pm.expect(jsonData).to.have.property('withdrawal');",
							"    const withdrawal = jsonData.withdrawal;",
							"    pm.expect(withdrawal).to.have.property('id');",
							"    pm.expect(withdrawal).to.have.property('amount');",
							"    pm.expect(withdrawal).to.have.property('status');",
							"    pm.expect(withdrawal).to.have.property('upi_id');",
							"});",
							"pm.test(\"Save withdrawal ID\", function () {",
							"    const withdrawal = pm.response.json().withdrawal;",
							"    if (withdrawal && withdrawal.id) {",
							"        pm.environment.set('withdrawal_id', withdrawal.id);",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"amount\": 100,\n  \"upiId\": \"{{upi_id}}\"\n}"
				},
				"url": {
					"raw": "{{api_base}}/api/member/withdraw",
					"host": ["{{api_base}}"],
					"path": ["api", "member", "withdraw"]
				},
				"description": "Request a withdrawal. Requires sufficient balance and valid UPI ID."
			},
			"response": []
		},
		{
			"name": "9. Withdrawals - Get Withdrawal History",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Response has withdrawals array\", function () {",
							"    const jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('withdrawals');",
							"    pm.expect(jsonData.withdrawals).to.be.an('array');",
							"});",
							"pm.test(\"Withdrawals have timestamps\", function () {",
							"    const withdrawals = pm.response.json().withdrawals;",
							"    if (withdrawals.length > 0) {",
							"        const withdrawal = withdrawals[0];",
							"        pm.expect(withdrawal).to.have.property('requested_at');",
							"        pm.expect(withdrawal).to.have.property('approved_at');",
							"        pm.expect(withdrawal).to.have.property('paid_at');",
							"        pm.expect(withdrawal).to.have.property('rejected_at');",
							"        pm.expect(withdrawal).to.have.property('receipt_url');",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{api_base}}/api/member/withdrawals?status=PENDING&page=1&perPage=20",
					"host": ["{{api_base}}"],
					"path": ["api", "member", "withdrawals"],
					"query": [
						{
							"key": "status",
							"value": "PENDING",
							"description": "Optional: PENDING, APPROVED, PAID, REJECTED"
						},
						{
							"key": "page",
							"value": "1"
						},
						{
							"key": "perPage",
							"value": "20"
						}
					]
				},
				"description": "Get withdrawal history with filters. Includes timestamps and receipt_url."
			},
			"response": []
		},
