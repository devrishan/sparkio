	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Set default values if not already set",
					"if (!pm.environment.get('api_base')) {",
					"    pm.environment.set('api_base', 'https://staging.api.earniq.app');",
					"}",
					"if (!pm.environment.get('phone')) {",
					"    pm.environment.set('phone', '9123456789');",
					"}"
				]
			}
		}
	],
