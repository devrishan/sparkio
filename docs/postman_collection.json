				},
				"description": "Update user profile. Can update username, email, and/or upi_id. Validates duplicates."
			},
			"response": []
		},
		{
			"name": "13. Auth - Logout",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Response indicates success\", function () {",
							"    const jsonData = pm.response.json();",
