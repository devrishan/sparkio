# PHP API configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sparkio
DB_USERNAME=root
DB_PASSWORD=

JWT_SECRET=replace-with-32-char-secret
JWT_TTL=3600

FRONTEND_ORIGIN=http://localhost:3000

# Next.js configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
API_BASE_URL=http://localhost:8080

# Prisma / PostgreSQL configuration (Earniq)
# Example: postgres://user:password@localhost:5432/earniq
DATABASE_URL=postgres://user:password@localhost:5432/earniq

# JWT configuration for Earniq Next.js backend
JWT_ACCESS_TOKEN_SECRET=replace-with-strong-access-secret
JWT_REFRESH_TOKEN_SECRET=replace-with-strong-refresh-secret
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# Redis configuration (for sessions, rate limiting, OTP, queues)
REDIS_URL=redis://localhost:6379

# OTP provider configuration (MSG91 / Twilio)
OTP_PROVIDER=msg91
MSG91_AUTH_KEY=your-msg91-key
MSG91_SENDER_ID=EARNIQ
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_FROM_NUMBER=+10000000000

# Payment gateway placeholders (Razorpay / Cashfree)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
CASHFREE_CLIENT_ID=your-cashfree-client-id
CASHFREE_CLIENT_SECRET=your-cashfree-client-secret

# File storage (Lovable Cloud / S3-compatible)
FILE_STORAGE_PROVIDER=lovable
FILE_STORAGE_BUCKET=earniq-files
FILE_STORAGE_REGION=ap-south-1
FILE_STORAGE_ACCESS_KEY=your-access-key
FILE_STORAGE_SECRET_KEY=your-secret-key

